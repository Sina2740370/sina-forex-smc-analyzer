# ============================================
#  SINA QUANT - Environment Variables
#  Never commit real API keys or bot tokens.
# ============================================

# ---- Required secrets (replace locally; do not commit real values) ----
FRED_API_KEY=replace_with_your_fred_api_key
TELEGRAM_BOT_TOKEN=replace_with_your_telegram_bot_token
TELEGRAM_CHAT_ID=replace_with_your_telegram_chat_id

# ---- Evaluation gates ----
TEST_DURATION_DAYS=20
MIN_WIN_RATE=0.65
MIN_TRADES=20
MIN_PROFIT_FACTOR=1.5
MAX_DRAWDOWN=0.15

# ---- Database ----
DB_PATH=signals.db

# ---- Scheduler ----
SCAN_INTERVAL_MINUTES=15

# ---- Diagnostic context weights (do not override the SMC direction) ----
WEIGHT_TECHNICAL=0.60
WEIGHT_FUNDAMENTAL=0.15
WEIGHT_NEWS=0.15
WEIGHT_MEMORY=0.10

# ---- Execution safety ----
MAX_ENTRY_SLIP_R=0.3
MAX_ENTRY_DELAY_MINUTES=30
ALLOW_GOLD_FUTURES_PROXY_SIGNALS=0
ACCOUNT_BALANCE=1000
LOT_RISK_PCT=0.5
MEMORY_ENABLED=0
BROKER_SUFFIX=
GOLD_SYMBOL=XAUUSD
