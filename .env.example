# ============================================
#  SMC Forex Analyzer - Environment Variables
# ============================================

# ---- FRED API ----
# هرگز کلید واقعی اینجا نگذار (قبلاً یک کلید واقعی کامیت شده بود!)
# فقط در Render → Environment ست کن و کلید قدیمی را revoke کن.
FRED_API_KEY=

# ---- تست ----
TEST_DURATION_DAYS=20
MIN_WIN_RATE=0.65
MIN_TRADES=20
MIN_PROFIT_FACTOR=1.5
MAX_DRAWDOWN=0.15

# ---- دیتابیس ----
DB_PATH=signals.db

# ---- زمان‌بند ----
SCAN_INTERVAL_MINUTES=15

# ---- وزن لایه‌ها (جمع باید ۱ باشد) ----
# لایه خبر فقط فیلتر سخت ایمنی است (بدون وزن امتیاز)؛ news_score در وزن دخیل نیست.
WEIGHT_TECHNICAL=0.70
WEIGHT_FUNDAMENTAL=0.20
WEIGHT_NEWS=0.00
WEIGHT_MEMORY=0.10
